          [c_canna_qu_infla#2@-1.096];
          [c_canna_qu_infla#3@-4.620];
          [c_canna_qu_infla#4@-3.180];

          %c#3%
          [c_canna_qu_infla#1@0.543];
          [c_canna_qu_infla#2@2.264];
          [c_canna_qu_infla#3@3.434];
          [c_canna_qu_infla#4@-2.360];

          %c#4%
          [c_canna_qu_infla#1@2.667];
          [c_canna_qu_infla#2@3.013];
          [c_canna_qu_infla#3@0.472];
